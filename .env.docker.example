# ==============================================================================
# Environment Configuration for Docker Deployment (DPRKP DKI Jakarta)
# ==============================================================================

APP_NAME="DPRKP DKI JAKARTA"
APP_ENV=production
APP_KEY=base64:74N2+Hp6rtlC0WmYdb3TKoV0kUdAgEstkTxKSrLuuCA=
APP_DEBUG=false
APP_URL=http://localhost:8006

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stderr
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Port Mapping (Port Host yang dialokasikan agar tidak bentrok)
# Terpakai di host: 3000, 5432, 5433, 5435, 8000, 8005, 8090, 9000, 9443, 50000
# ------------------------------------------------------------------------------
APP_PORT=8006
FORWARD_DB_PORT=5436

# ------------------------------------------------------------------------------
# Konfigurasi Database PostgreSQL di Docker
# (Host DB menggunakan nama container 'dprkp-db' di dalam network dprkp-network)
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=dprkp-db
DB_PORT=5432
DB_DATABASE=dprkp
DB_USERNAME=postgres
DB_PASSWORD=myamlabar

# ------------------------------------------------------------------------------
# Driver Session, Cache, & Queue (Tersimpan di PostgreSQL)
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# ------------------------------------------------------------------------------
# Otomasi Startup Container
# ------------------------------------------------------------------------------
AUTORUN_MIGRATIONS=true
AUTORUN_SEED=false

VITE_APP_NAME="${APP_NAME}"
